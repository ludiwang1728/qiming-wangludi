# ===== Supabase（起名历史存储）=====
# Supabase 控制台 → Project Settings → API 里复制
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# 正式上线建议换成 service_role key（只放在服务端，切勿暴露给前端）
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 表名默认 name_history，改了表名才需要设置
# SUPABASE_TABLE=name_history

# ===== 大模型密钥（4 个模型配任意几个都能用，未配置的模型前端会标灰）=====
# 豆包（火山方舟）https://console.volcengine.com/ark
DOUBAO_API_KEY=your-ark-api-key
# 火山方舟的模型 ID：控制台创建推理接入点后复制，形如 ep-2025xxxx 或 doubao-seed-1-6-250615
DOUBAO_MODEL=doubao-seed-1-6-250615

# DeepSeek https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# 通义千问 DashScope https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key

# Kimi（月之暗面）https://platform.moonshot.cn
KIMI_API_KEY=your-moonshot-api-key
KIMI_MODEL=kimi-k2-0711-preview

# ===== 可选：接口地址覆盖（一般不用改，本地联调时会用到）=====
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ===== 演示模型开关 =====
# 1（默认）= 前端多一个「演示模型（本地模拟）」，不需要任何密钥就能跑通流式输出与历史记录
# 0 = 前端只显示接到 key 的真实模型
DEMO_MODE=1

# ===== 可选：表名（默认 name_history，改了才需要设置）=====
# SUPABASE_TABLE=name_history
